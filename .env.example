# Zkopíruj jako .env a doplň. Soubor .env se do gitu nikdy nedostane.

# Gumroad: Settings → Advanced → Applications → Generate access token
GUMROAD_ACCESS_TOKEN=

# CGTrader (M4, až bude přístup)
# CGTRADER_CLIENT_ID=
# CGTRADER_CLIENT_SECRET=

# Ranní souhrn e-mailem (M5): účet na resend.com → API Keys → Create API Key (oprávnění Sending access)
# REPORT_EMAIL_TO = e-mail, kterým ses na Resend registroval (bez vlastní domény jde poslat jen na něj)
RESEND_API_KEY=
REPORT_EMAIL_TO=
# REPORT_EMAIL_FROM=Sales tracker <onboarding@resend.dev>

# Týdenní komentář od Claude (M5b): console.anthropic.com → Billing (kredit) → API Keys → Create Key
# Bez klíče přijde týdenní shrnutí jen s čísly od kódu.
ANTHROPIC_API_KEY=
